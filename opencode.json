{
    "$schema": "https://opencode.ai/config.json",
    "autoupdate": "notify",
    "model": "openai/gpt-5-nano",
    "permission": {
        "*": "allow",
        "git commit": "allow",
        "git commit *": "allow",
        "git push *": "deny",
        "git checkout -b": "deny",
        "git checkout -b *": "deny",
        "git switch -c": "deny",
        "git switch -c *": "deny",
        "git branch": "deny",
        "git branch *": "deny",
        "external_directory": "allow",
        "doom_loop": "ask"
    },
    "provider": {
        "openai": {
            "models": {
                "gpt-5-nano": {
                    "options": {
                        "reasoningEffort": "high",
                        "reasoningSummary": "auto",
                        "textVerbosity": "low"
                    }
                }
            },
            "options": {
                "apiKey": ""
            }
        }
    }
}
